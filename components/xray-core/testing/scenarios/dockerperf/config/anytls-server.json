{
  "log": { "loglevel": "warning" },
  "metrics": { "listen": "0.0.0.0:10086" },
  "inbounds": [{
    "tag": "anytls-in",
    "listen": "0.0.0.0",
    "port": 443,
    "protocol": "anytls",
    "settings": {
      "users": [{
        "email": "docker-performance@example.com",
        "password": "docker-performance-password"
      }]
    },
    "streamSettings": {
      "network": "tcp",
      "security": "tls",
      "tlsSettings": {
        "certificates": [{
          "certificateFile": "/lab/tls/certificate.pem",
          "keyFile": "/lab/tls/key.pem"
        }]
      }
    }
  }],
  "outbounds": [{
    "tag": "direct",
    "protocol": "freedom",
    "settings": { "ipsBlocked": [] }
  }]
}
