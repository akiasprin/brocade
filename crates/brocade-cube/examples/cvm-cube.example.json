{
  "virtualization_mode": "kvm",
  "cubelet_socket": "/run/cubelet/cubelet.sock",
  "network_inspection_url": "http://127.0.0.1:18080/v1/network/taps",
  "storage_backend": "xfs",
  "capabilities": {
    "create": true,
    "delete": true,
    "stop": true,
    "start": true,
    "stable_storage": true,
    "hot_attach": true,
    "hot_detach": true,
    "max_interfaces": 3,
    "allocatable_vcpus": 8,
    "allocatable_memory_bytes": 8589934592,
    "allocatable_disk_bytes": 85899345920,
    "images": [
      {
        "id": "debian-13",
        "name": "Debian",
        "version": "13",
        "architecture": "x86_64",
        "sha256": "REPLACE_WITH_SYSTEM_MANIFEST_SHA256",
        "boot_mode": "cube-oci"
      }
    ],
    "network_sources": [
      {
        "id": "cube-contact",
        "name": "主网卡网络",
        "kind": "public",
        "description": "公网访问通过已发布的访问入口；业务网卡从控制面分配"
      }
    ],
    "resource_limits": {
      "min_vcpus": 1,
      "max_vcpus": 8,
      "min_memory_bytes": 134217728,
      "max_memory_bytes": 4294967296,
      "memory_step_bytes": 67108864,
      "min_root_disk_bytes": 3221225472,
      "max_root_disk_bytes": 68719476736,
      "root_disk_step_bytes": 1073741824
    },
    "restart": true,
    "reinstall": true,
    "configure": true,
    "retain_on_delete": false
  },
  "image_files": {
    "debian-13": "/var/lib/brocade/cvm-cube/images/debian13.system.json"
  }
}
